# Kaththokra server environment (docs/BACKEND_PLAN.md §10).
# Copy to .env.local for local dev; set the same names in Vercel → Settings → Environment Variables.
# Only NEXT_PUBLIC_* values reach the browser. Never put a secret in a NEXT_PUBLIC_ variable.
# Validated at runtime by src/server/env.ts; a bad value fails fast with the list of problems.

# ---------- App ----------
# Public base URL. Used for the Origin check on POST/PUT/DELETE (production only) and for QR links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true shows the Demo controls. Requires GEMINI_MODE=mock and APPLINK_MODE=mock.
NEXT_PUBLIC_DEMO_MODE=false

# ---------- MongoDB (Atlas) ----------
# Required. Atlas → Connect → Drivers. Network Access must allow 0.0.0.0/0 (Vercel has no fixed IP).
MONGODB_URI=
MONGODB_DB=kaththokra

# ---------- Gemini ----------
# live | mock (default mock). In mock mode no key is needed.
GEMINI_MODE=mock
# Required when GEMINI_MODE=live. Google AI Studio → Get API key.
GEMINI_API_KEY=
# Required when GEMINI_MODE=live: the current stable Flash model on the free tier.
GEMINI_MODEL=
# Optional: Flash-Lite, tried once on 429/timeout.
GEMINI_FALLBACK_MODEL=

# ---------- Applink ----------
# mock | live (default mock). In mock mode nothing leaves the server.
APPLINK_MODE=mock
APPLINK_BASE_URL=https://api.applink.com.bd
# Required when APPLINK_MODE=live (farmer app).
APPLINK_APP_ID=
APPLINK_PASSWORD=
# Optional second app for dealers; falls back to the farmer app when empty.
APPLINK_DEALER_APP_ID=
APPLINK_DEALER_PASSWORD=
# Required when APPLINK_MODE=live. Fixie static-IP proxy: http://fixie:<token>@<host>:80
# Put BOTH Fixie IPs in Applink's "Allowed Host Address(es)".
FIXIE_URL=
# Long random string, part of every callback URL:
#   https://<app>/api/callbacks/<type>/<CALLBACK_TOKEN>
# Required when APPLINK_MODE=live and in production.
CALLBACK_TOKEN=

# ---------- Secrets ----------
# Required in production. Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Bearer token for /api/jobs/* (GitHub Actions cron). Also add it as the GitHub repository secret JOBS_SECRET.
JOBS_SECRET=
# Optional. Vercel sets this for its own cron requests (vercel.json → /api/jobs/reconcile); also accepted by /api/jobs/*.
CRON_SECRET=
# Mixed into session-token hashes.
SESSION_PEPPER=

# ---------- Legacy (removed in F7) ----------
# Still read by src/lib/applink.ts, which talks to the archived Oracle proxy (infra/_archive/applink-proxy).
# APPLINK_PROXY_URL=
# APPLINK_PROXY_SECRET=
